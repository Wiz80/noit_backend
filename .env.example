# Application
ENVIRONMENT=development
DEBUG=True

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=business_ai
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# JWT
SECRET_KEY=your_secret_key
ALGORITHM=HS256

# API Keys
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# n8n Webhook for Research
N8N_WEBHOOK_URL=https://masterchief.app.n8n.cloud/webhook/your_webhook_id
N8N_AUTH_HEADER=your_base64_encoded_auth

# Kestra
KESTRA_HOST=localhost:8084
KESTRA_WEBHOOK_KEY=your_kestra_webhook_key

# MinIO
MINIO_ENDPOINT=your_minio_endpoint
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_REGION=your_minio_region
MINIO_USE_SSL=True

MINIO_SCRAPING_ENDPOINT=localhost:9000
MINIO_SCRAPING_USE_SSL=False
MINIO_SCRAPING_ROOT_USER=your_scraping_minio_user
MINIO_SCRAPING_ROOT_PASSWORD=your_scraping_minio_password

# Apify
APIFY_API_KEY=your_apify_api_key

# Temporary file paths
ZIP_TEMPORAL_FILE_PATH=/path/to/your/temp/directory 