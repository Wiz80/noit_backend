    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Main Script",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Business Analyzer",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/competitive_analysis/business_analyzer.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Webhook webscraper",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/competitive_analysis/kestra_scrape_requester.py",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}