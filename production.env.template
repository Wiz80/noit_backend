# ===========================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ===========================================
# Copy this file to .env and fill in the secure values
# DO NOT commit .env file to version control!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Main Application Database
POSTGRES_USER=your_secure_postgres_user
POSTGRES_PASSWORD=your_very_secure_postgres_password
POSTGRES_DB=noit_backend_prod

# Kestra Database
KESTRA_POSTGRES_DB=kestra_prod
KESTRA_POSTGRES_USER=kestra_prod_user
KESTRA_POSTGRES_PASSWORD=your_secure_kestra_postgres_password

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_PASSWORD=your_very_secure_redis_password_here
REDIS_PORT=6379

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
APP_PORT=8000

# ===========================================
# NGINX CONFIGURATION
# ===========================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ===========================================
# TASKIQ CONFIGURATION
# ===========================================
# Generate a strong random token for Taskiq Admin API
TASKIQ_ADMIN_API_TOKEN=your_super_secure_taskiq_admin_token_here_min_32_chars
TASKIQ_ADMIN_PORT=3000

# ===========================================
# KESTRA WORKFLOW ENGINE CONFIGURATION
# ===========================================
# Kestra Admin Configuration
KESTRA_BASIC_AUTH_ENABLED=true
KESTRA_ADMIN_EMAIL=admin@yourdomain.com
KESTRA_ADMIN_PASSWORD=your_secure_kestra_admin_password

# Kestra Ports
KESTRA_PORT=8080
KESTRA_MANAGEMENT_PORT=8081

# Kestra URL (adjust for your domain)
KESTRA_URL=https://kestra.yourdomain.com/

# ===========================================
# SECURITY RECOMMENDATIONS
# ===========================================
# 1. Use strong passwords (min 16 characters, mix of letters, numbers, symbols)
# 2. Generate random tokens using: openssl rand -base64 32
# 3. Use different passwords for each service
# 4. Consider using a password manager
# 5. Enable firewall rules to restrict access to services
# 6. Use SSL/TLS certificates for HTTPS
# 7. Regularly rotate passwords and tokens
# 8. Monitor logs for suspicious activity

# ===========================================
# ADDITIONAL PRODUCTION VARIABLES (Optional)
# ===========================================
# Uncomment and configure if needed

# JWT Secret for your application
# JWT_SECRET_KEY=your_jwt_secret_key_here

# API Keys for external services
# EXTERNAL_API_KEY=your_external_api_key

# Email configuration
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=your_smtp_password

# Logging level
# LOG_LEVEL=INFO

# Environment
# ENVIRONMENT=production 