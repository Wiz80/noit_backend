# Application
ENVIRONMENT=development
DEBUG=True

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=business_ai
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# JWT
SECRET_KEY=your_secret_key
ALGORITHM=HS256

# API Keys
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# n8n Webhook for Research
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/instagram-research
N8N_AUTH_HEADER=auth_user
N8N_WEBHOOK_TIMEOUT=60
API_CALLBACK_BASE_URL=http://localhost:8000

# Kestra
KESTRA_HOST=localhost:8084
KESTRA_WEBHOOK_KEY=your_kestra_webhook_key

# MinIO
MINIO_ENDPOINT=your_minio_endpoint
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_REGION=your_minio_region
MINIO_USE_SSL=True

MINIO_SCRAPING_ENDPOINT=localhost:9000
MINIO_SCRAPING_USE_SSL=False
MINIO_SCRAPING_ROOT_USER=your_scraping_minio_user
MINIO_SCRAPING_ROOT_PASSWORD=your_scraping_minio_password

# Apify
APIFY_API_KEY=your_apify_api_key

# API base URL (used by Mage.ai to call back to FastAPI)
API_BASE_URL=http://localhost:8000

# Database connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/business_ai

# Redis connection
REDIS_URL=redis://localhost:6379/0

# Mage.ai API URL (used by FastAPI to trigger Mage.ai)
MAGE_API_URL=http://localhost:6789/api

# For local development, set to use direct processing instead of Mage.ai
# Set to "false" to use Mage.ai for pipeline execution
USE_DIRECT_PROCESSING=true 